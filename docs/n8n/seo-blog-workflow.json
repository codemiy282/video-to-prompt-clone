        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  title: $json.post_title,\n  content: $json.post_content,\n  excerpt: $json.post_excerpt,\n  status: 'draft'\n}) }}",
        "options": {
          "timeout": 60000
