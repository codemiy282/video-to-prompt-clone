      },
      "id": "n015",
      "name": "WP: Tao bai nhap",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2600,
        120
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// === Xem WordPress có nhận bài không ===\nconst topic = $('DATA: Tach tieu de va noi dung').first().json;\nconst res = $input.first().json;\n\n// WordPress trả về object có id khi tạo thành công.\nconst postId = res?.id || null;\nconst ok = Boolean(postId);\n\nreturn [{ json: {\n  ...topic,\n  _published_ok: ok,\n  wp_post_id: postId || '',\n  wp_edit_url: ok ? `${$env.WP_URL}/wp-admin/post.php?post=${postId}&action=edit` : '',\n  status: ok ? 'draft' : 'failed',\n  error_message: ok ? '' : (res?.message || 'Khong tao duoc bai'),\n  created_at: new Date().toISOString(),\n} }];"
      },
