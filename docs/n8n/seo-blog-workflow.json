      },
      "id": "n008",
      "name": "LOG: Doc bai da viet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// === Bỏ chủ đề đã viết, và chặn khi đã đủ số bài trong ngày ===\n//\n// Hai việc gộp một chỗ vì cùng đọc một nguồn: bảng bài đã đăng.\n//   - Chống trùng: cùng topic_id đã có bài thì bỏ qua.\n//   - Hạn mức ngày: đếm bài tạo hôm nay, chạm trần thì dừng.\n//\n// Trần lấy từ biến môi trường để đổi nhịp đăng mà không phải sửa workflow.\nconst topic = $('DATA: Chia tung chu de').first().json;\nconst posts = $('LOG: Doc bai da viet').all();\n\nconst dailyCap = parseInt($env.BLOG_POSTS_PER_DAY || '2', 10);\nconst today = new Date().toISOString().split('T')[0];\n\nconst writtenTopics = new Set();\nlet createdToday = 0;\n\nfor (const p of posts) {\n  const row = p.json;\n  if (row.topic_id) writtenTopics.add(String(row.topic_id));\n  if ((row.created_at || '').startsWith(today)) createdToday++;\n}\n\nlet shouldWrite = true;\nlet skipReason = '';\n\nif (writtenTopics.has(String(topic.topic_id))) {\n  shouldWrite = false;\n  skipReason = 'da_co_bai';\n} else if (createdToday >= dailyCap) {\n  shouldWrite = false;\n  skipReason = 'het_han_muc_ngay';\n}\n\nreturn [{ json: {\n  ...topic,\n  _should_write: shouldWrite,\n  _skip_reason: skipReason,\n  _created_today: createdToday,\n  _daily_cap: dailyCap,\n} }];"
      },
      "id": "n009",
      "name": "DATA: Chong trung va han muc",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json._should_write }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n010",
      "name": "IF: Co nen viet?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1600,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  system_instruction: { parts: [{ text: `Ban la nguoi viet noi dung SEO cho mot cong cu AI lam video.\n\nViet bai chuan SEO bang ngon ngu duoc yeu cau. Yeu cau:\n- Bam sat tu khoa chinh, dat tu khoa o tieu de va doan mo dau.\n- Viet cho nguoi doc that, khong nhoi tu khoa.\n- Dung the HTML don gian: <h2>, <h3>, <p>, <ul>, <li>, <strong>. KHONG dung <h1>.\n- Do dai khoang 800-1200 tu.\n- Khong bia so lieu, khong bia trich dan.\n\nTra ve DUNG dinh dang sau, khong them gi khac:\n\n[TITLE]\n<tieu de bai viet, duoi 60 ky tu>\n[EXCERPT]\n<tom tat 1-2 cau, duoi 155 ky tu>\n[CONTENT]\n<noi dung HTML>` }] },\n  contents: [{ role: 'user', parts: [{ text:\n    `Tu khoa chinh: ${$json.keyword}\\n` +\n    `Goi y tieu de: ${$json.title_hint}\\n` +\n    `Ngon ngu: ${$json.language || 'Tieng Viet'}\\n` +\n    ($json.notes ? `Ghi chu them: ${$json.notes}\\n` : '') +\n    `\\nViet bai theo dung dinh dang da yeu cau.` }] }]\n}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "n011",
      "name": "AI: Viet bai",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// === Tách [TITLE] / [EXCERPT] / [CONTENT] từ kết quả AI ===\n//\n// Dùng khối có nhãn thay vì JSON: nội dung bài viết đầy dấu nháy, dấu hai chấm\n// và xuống dòng — những thứ làm vỡ JSON. Nhãn thì không bị ảnh hưởng.\nconst topic = $('DATA: Chong trung va han muc').first().json;\nconst res = $input.first().json;\n\nconst raw = res?.candidates?.[0]?.content?.parts?.[0]?.text || '';\n\nfunction field(label, next) {\n  const re = new RegExp(`\\\\[${label}\\\\]([\\\\s\\\\S]*?)(?=\\\\[${next}\\\\]|$)`, 'i');\n  const m = raw.match(re);\n  return m ? m[1].trim() : '';\n}\n\nconst title = field('TITLE', 'EXCERPT');\nconst excerpt = field('EXCERPT', 'CONTENT');\nconst content = field('CONTENT', 'KHONG_CO_NHAN_NAY');\n\n// Không có tiêu đề hoặc nội dung thì coi như thất bại — đừng đẩy bài rỗng lên\n// WordPress rồi mới phát hiện.\nconst ok = Boolean(title && content);\n\nreturn [{ json: {\n  ...topic,\n  _ai_ok: ok,\n  _ai_error: ok ? '' : 'AI tra ve khong dung dinh dang',\n  post_title: title,\n  post_excerpt: excerpt,\n  post_content: content,\n} }];"
      },
      "id": "n012",
      "name": "DATA: Tach tieu de va noi dung",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
